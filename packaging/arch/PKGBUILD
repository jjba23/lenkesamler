pkgname=lenkesamler
pkgver=0.1.0
pkgrel=1
pkgdesc="Bookmark manager, sync tool and archiver in Guile Scheme"
arch=('any')
url="https://codeberg.org/jjba23/lenkesamler"
license=('MIT')

depends=(
  'guile'
  'bash'
  'coreutils'
  'guile-json'
  'guile-lib'
)

makedepends=(
  'guile'
  'pkgconf'
)

checkdepends=(
  'veritas'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('116026b236fe3c316704bd99a8f16c71c0f6ecaf91ef29cd199ed36177c88f4a')

# veritas is produced by the same packaging batch; build it first.

# Upstream reads resources and the log helper from the generic
# share/resources and share/scripts; several of these packages
# would clash there, so both move under share/lenkesamler/.

# Guile looks for byte-compiled modules under the site-ccache directory,
# which differs between distributions, so ask Guile's pkg-config file
# instead of hard-coding a path.
_site_dir() {
  pkg-config --variable=sitedir guile-3.0 2>/dev/null \
    || echo /usr/share/guile/site/3.0
}

_compiled_dir() {
  pkg-config --variable=siteccachedir guile-3.0 2>/dev/null \
    || echo /usr/lib/guile/3.0/site-ccache
}

build() {
  cd "$srcdir/lenkesamler"

  # Byte-compile every module, mirroring the source tree under a staging
  # directory that package() copies into the compiled site directory.
  rm -rf "$srcdir/ccache"
  mkdir -p "$srcdir/ccache/lenkesamler"

  while IFS= read -r scm_file; do
    rel_path="${scm_file#src/}"
    go_file="$srcdir/ccache/${rel_path%.scm}.go"
    mkdir -p "$(dirname "$go_file")"
    guild compile -L src -o "$go_file" "$scm_file"
  done < <(find src/lenkesamler -name '*.scm')
}

check() {
  cd "$srcdir/lenkesamler"

  mkdir -p reports/spec
  VERITAS_TEST_TYPE=unit VERITAS_RUN_BENCHMARKS=false guile -L ./src -L ./test -c '((@ (veritas runner) run-tests))'
}

package() {
  cd "$srcdir/lenkesamler"

  # The launcher resolves its modules and resources relative to its
  # own prefix, so the installed layout below is what it expects.
  install -Dm755 scripts/lenkesamler "$pkgdir/usr/bin/lenkesamler"
  sed -i 's|share/resources|share/lenkesamler/resources|g; s|share/scripts|share/lenkesamler/scripts|g' "$pkgdir/usr/bin/lenkesamler"

  site_dir="$(_site_dir)"
  install -d "$pkgdir${site_dir}/lenkesamler"
  cp -r src/lenkesamler/. "$pkgdir${site_dir}/lenkesamler/"

  ccache_dir="$(_compiled_dir)"
  install -d "$pkgdir${ccache_dir}/lenkesamler"
  cp -r "$srcdir/ccache/lenkesamler/." "$pkgdir${ccache_dir}/lenkesamler/"

  install -d "$pkgdir/usr/share/lenkesamler/resources"
  cp -r resources/. "$pkgdir/usr/share/lenkesamler/resources/"
  install -Dm644 scripts/log.bash "$pkgdir/usr/share/lenkesamler/scripts/log.bash"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
  install -Dm644 NEWS.org "$pkgdir/usr/share/doc/$pkgname/NEWS.org"
}
