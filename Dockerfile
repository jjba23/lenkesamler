# syntax=docker/dockerfile:1.7

# lenkesamler
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile guile-devel gcc make autoconf automake libtool \
        pkg-config gawk gnulib-devel gettext-tools findutils \
        libcurl-devel sqlite3-devel guile-json guile-gcrypt \
        guile-fibers tar gzip; \
    zypper clean --all

# Build the Guile libraries openSUSE does not package.  They are
# copied into the runtime with the project, so the image needs no
# extra repository or post-install step.

ADD https://download.savannah.gnu.org/releases/guile-lib/guile-lib-0.2.8.1.tar.gz /tmp/guile-lib.tar.gz
RUN set -eu; \
    mkdir -p "/tmp/guile-lib"; \
    tar xzf "/tmp/guile-lib.tar.gz" -C "/tmp/guile-lib" --strip-components=1; \
    cd "/tmp/guile-lib"; \
    ./configure --prefix=/usr --with-guile-site=yes; \
    make -j"$(nproc)"; \
    make install

COPY src/lenkesamler ./src/lenkesamler
COPY scripts/lenkesamler ./scripts/lenkesamler
COPY resources ./resources
COPY scripts/log.bash ./scripts/log.bash

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/lenkesamler"; \
    cp -r "src/lenkesamler/." "$site/lenkesamler/"; \
    install -D -m 0755 "scripts/lenkesamler" "/usr/bin/lenkesamler"; \
    sed -i '1s|^#!/usr/bin/env \(.*\)$|#!/usr/bin/\1|' "/usr/bin/lenkesamler"; \
    sed -i 's|share/resources|share/lenkesamler/resources|g; s|share/scripts|share/lenkesamler/scripts|g' "/usr/bin/lenkesamler"; \
    install -d "/usr/share/lenkesamler/resources"; \
    cp -r resources/. "/usr/share/lenkesamler/resources/"; \
    install -D -m 0644 scripts/log.bash "/usr/share/lenkesamler/scripts/log.bash"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="lenkesamler" \
      org.opencontainers.image.description="Bookmark manager, sync tool and archiver in Guile Scheme" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/lenkesamler" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates \
        guile-json \
        bash \
        coreutils; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site /usr/share/guile/site
COPY --from=builder /usr/lib64/guile /usr/lib64/guile
RUN ldconfig
COPY --from=builder /usr/bin/lenkesamler /usr/bin/lenkesamler
COPY --from=builder /usr/share/lenkesamler /usr/share/lenkesamler

ENTRYPOINT ["/usr/bin/lenkesamler"]
