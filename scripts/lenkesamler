#!/usr/bin/env bash

# lenkesamler
#
# SPDX-License-Identifier: MIT
# Copyright © Josep Bigorra <jjbigorra@gmail.com>

# Commentary:
#
# This bash script provides a convenient and user-friendly wrapper
# around the command-line usage of `lenkesamler`, allowing the
# Guile Scheme application to behave and feel like any other
# executable or binary that users may install to their systems.
#
# This also helps installing `lenkesamler` in a convenient fashion
# to the Guix store and it allows us to decouple the user-facing
# command-line interface from the internal Guile Scheme arguments
# to the main program and library.
#
# Some of the rationale behind the `SCRIPT_DIR` and `STORE_DIR`
# can be explained due to the need of reliably and reproducibly
# deploying source code and other resources to the Guix store
# and have access to those at runtime.

set -euo pipefail

script_dir=$(dirname "$0")
store_dir=$(readlink -f "$script_dir/..")
scheme_sources_dir="${store_dir}/share/guile/site/3.0"
resources_dir="${store_dir}/share/resources"
scripts_dir="${store_dir}/share/scripts"

source "${scripts_dir}/log.bash"

show_help() {
  cat "${resources_dir}/help.txt"
}

parsed_options=$(getopt -n "lenkesamler" -o m:d:f:i:ch \
  --long mode:,destination:,file:,import:,check,help -- "$@")

eval set -- "${parsed_options}"

mode_arg=""
destination_arg=""
file_arg=""
import_arg=""

guile_cmd_args=(
  "-L" "${scheme_sources_dir}"
  "-c" "((@(lenkesamler main) main))"
)

while true; do
  case "${1}" in
  -m | --mode)
    mode_arg="${2}"
    [[ -n "${mode_arg}" ]] && guile_cmd_args+=("--mode" "${mode_arg}")
    shift 2
    ;;
  -d | --destination)
    destination_arg="${2}"
    [[ -n "${destination_arg}" ]] && guile_cmd_args+=("--destination" "${destination_arg}")
    shift 2
    ;;
  -f | --file)
    file_arg="${2}"
    guile_cmd_args+=("--file" "$(realpath "${file_arg}")")
    shift 2
    ;;
  -i | --import)
    import_arg="${2}"
    [[ -n "${import_arg}" ]] && guile_cmd_args+=("--import" "$(realpath "${import_arg}")")
    shift 2
    ;;
  -c | --check)
    guile_cmd_args+=("--check")
    shift
    ;;
  -h | --help)
    show_help
    exit 0
    ;;
  --)
    shift
    break
    ;;
  *)
    log_error "Internal error: unrecognized option '${1}'"
    show_help
    exit 1
    ;;
  esac
done

# The bookmarks: either this project's own file, or the one a browser wrote
if [[ -z "${file_arg}" && -z "${import_arg}" ]]; then
  log_error "Error: One of -f/--file or -i/--import is required." >&2
  show_help
  exit 1
fi

if [[ -n "${file_arg}" && -n "${import_arg}" ]]; then
  log_error "Error: Use either -f/--file or -i/--import, not both." >&2
  show_help
  exit 1
fi

log_info "-------------------------------------------------"
log_info "Starting Lenkesamler: guile ${guile_cmd_args[*]}"

# Run Guile application
exec guile "${guile_cmd_args[@]}"
